diff --git a/src/game/menuentry.c b/src/game/menuentry.c
index facb381..40ae767 100644
--- a/src/game/menuentry.c
+++ b/src/game/menuentry.c
@@ -47,7 +47,9 @@
 #include "xbox_settings.h"
 #endif
 
+#if !defined(RECOMP_REGFILE)   /* the PS5: platform/recomp_regfile.h */
 extern RECOMP_TLS uint32_t g_eax, g_ebx, g_ecx, g_edx, g_esi, g_edi, g_esp;
+#endif
 extern ptrdiff_t g_xbox_mem_offset;
 extern void sub_001D2879(void);          /* the title's heap: (size, tag), stdcall */
 
@@ -195,10 +197,59 @@ static void me_select(void)
 #endif
 }
 
+/* ── the main menu, without XBOX LIVE (the PlayStation 5) ─────────────
+ *
+ * The main menu (BURNOUT 3 WORLD TOUR, SINGLE EVENT, MULTIPLAYER, XBOX LIVE,
+ * DRIVER DETAILS) is built by sub_00077DC0 into the page it is given: +4
+ * the last choice, +0x14 the cursor, +0x16 the count (5), +0x18 five items
+ * of 8 bytes (label, a "not available" byte the A handler checks, a spare),
+ * +0x40 five scrolling help lines. Xbox Live is gone, and a console has no
+ * use for its line: the "mm_items" mark (after the count is stored, edi the
+ * page + 0x14) moves DRIVER DETAILS and its help line up over it and makes
+ * the count 4. The A handler (sub_00078160) stores the cursor as the choice
+ * the next page is picked by, 3 being XBOX LIVE: the "mm_select" mark
+ * (eax the cursor, edi the page) makes the fourth line's 3 a 4, DRIVER
+ * DETAILS. Coming back, the cursor starts from the last choice: 4 is the
+ * fourth line, 3. */
+#define MM_LIVE   3u
+#define MM_LAST   4u
+static uint32_t s_mm_page;
+
+static void mm_items(void)
+{
+#if defined(__PROSPERO__)
+    uint32_t page = g_edi - 0x14;
+
+    if (!g_xbox_mem_offset || ME_M16(page + 0x16) != MM_LAST + 1)
+        return;
+    ME_M32(page + 0x18 + MM_LIVE * 8) = ME_M32(page + 0x18 + MM_LAST * 8);
+    ME_M32(page + 0x18 + MM_LIVE * 8 + 4) = ME_M32(page + 0x18 + MM_LAST * 8 + 4);
+    ME_M32(page + 0x40 + MM_LIVE * 4) = ME_M32(page + 0x40 + MM_LAST * 4);
+    ME_M16(page + 0x16) = MM_LAST;
+    if (ME_M16(page + 0x14) >= MM_LIVE)
+        ME_M16(page + 0x14) = MM_LIVE;
+    if (s_mm_page != page)
+        fprintf(stderr, "[MENU] main menu: XBOX LIVE taken out (page 0x%08X)\n", page);
+    s_mm_page = page;
+#endif
+}
+
+static void mm_select(void)
+{
+#if defined(__PROSPERO__)
+    if (!g_xbox_mem_offset || g_edi != s_mm_page || ME_M16(g_edi + 0x16) != MM_LAST)
+        return;
+    if (g_eax == MM_LIVE)
+        g_eax = MM_LAST;
+#endif
+}
+
 void bo3_menu_entry_start(void)
 {
     recomp_patch_on_mark("si_items", me_items);
     recomp_patch_on_mark("si_select", me_select);
     recomp_patch_on_mark("pe_items", pe_items);
     recomp_patch_on_mark("pe_select", pe_select);
+    recomp_patch_on_mark("mm_items", mm_items);
+    recomp_patch_on_mark("mm_select", mm_select);
 }
