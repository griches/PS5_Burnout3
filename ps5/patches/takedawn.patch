@@ -1081,6 +1081,37 @@ int bo3_install_main(int argc, char **argv)
     return 0;
 }
 
+/* The installer with this program's disc manifest, for a front end of its own
+ * (the PlayStation 5's first start, ps5/src/firstrun.c in that port): source
+ * an image or a folder, the files into <dest>/GAME_DIR and the marker into
+ * <dest>, or with check_only only what the source is. Returns the installer's
+ * code (XR_INSTALL_OK ...) and puts its sentence for the player in message. */
+int bo3_install_from(const char *source, const char *dest, int check_only,
+                     void (*progress)(void *ctx, double fraction, const char *text),
+                     void *ctx, char *message, size_t n)
+{
+    xr_install_opts o;
+    xr_install_result r;
+
+    memset(&o, 0, sizeof o);
+    memset(&r, 0, sizeof r);
+    o.source = source;
+    o.source_fd = -1;
+    o.dest = dest;
+    o.subdir = GAME_DIR;
+    o.manifest = &k_manifest;
+    o.version = BO3_VERSION;
+    o.free_needed = FREE_NEEDED;
+    o.identify_only = check_only;
+    o.ctx = ctx;
+    o.progress = progress;
+    o.log = install_log;
+    xr_install(&o, &r);
+    if (message && n)
+        snprintf(message, n, "%s", r.message);
+    return r.code;
+}
+
 /* ── Android: the setup page's installer ───────────────────────────── */
 
