diff --git a/src/platform/recomp_regfile.h b/src/platform/recomp_regfile.h
new file mode 100644
index 0000000..0cbc67b
--- /dev/null
+++ b/src/platform/recomp_regfile.h
@@ -0,0 +1,107 @@
+/*
+ * recomp_regfile.h - the guest's registers in one thread-local block, on the
+ * PlayStation 5.
+ *
+ * The registers are thread-local (RECOMP_TLS, recomp_types.h): each guest
+ * thread has its own set. The console's titles are built with emulated TLS,
+ * where every access to a thread-local is a call (__emutls_get_address,
+ * about 3.4 ns over a plain load), and lifted code touches eax, esp and the
+ * rest in nearly every statement: one host instruction in seven was such a
+ * call, and Burnout 3's CPU work overran its frames. Native TLS is not open
+ * to a title there.
+ *
+ * So the registers live in one thread-local struct, reached through
+ * recomp_regfile(), which is declared const: its result depends on nothing
+ * the compiler can see change, so a function asks once and keeps the pointer
+ * (glibc's __errno_location is declared the same way). The g_* names become
+ * that struct's fields, for the generated code and the runtime alike.
+ *
+ * Force-included into every source of a console build, before
+ * recomp_types.h and xbox_memory_layout.h, whose own declarations of these
+ * names step aside (RECOMP_REGFILE). Elsewhere this header is empty.
+ */
+#ifndef RECOMP_REGFILE_H
+#define RECOMP_REGFILE_H
+
+#if defined(__PROSPERO__)
+#include <stdint.h>
+
+#define RECOMP_REGFILE 1
+
+/* The SSE and MMX registers' types, as recomp_types.h and
+ * xbox_memory_layout.h define them (which skip theirs when these exist). */
+#ifndef RECOMP_XMM_DEFINED
+#define RECOMP_XMM_DEFINED
+typedef union RecompXmm {
+    float    f[4];
+    double   d[2];
+    uint32_t u[4];
+    int32_t  i[4];
+    uint64_t q[2];
+} RecompXmm;
+#endif
+#ifndef RECOMP_MMX_DEFINED
+#define RECOMP_MMX_DEFINED
+typedef union RecompMmx {
+    int8_t   b[8];
+    uint8_t  ub[8];
+    int16_t  w[4];
+    uint16_t uw[4];
+    int32_t  d[2];
+    uint32_t ud[2];
+    uint64_t q;
+} RecompMmx;
+#endif
+
+/* (r_ names: the generated code defines eax, esp ... as macros) */
+typedef struct RecompRegFile {
+    uint32_t r_eax, r_ecx, r_edx, r_esp, r_ebx, r_esi, r_edi, r_ebp;
+    uint32_t r_fs_base, r_seh_ebp, r_eflags;
+    int r_df, r_fp_top, r_fp_cmp;
+    uint16_t r_fp_control_word, r_fp_cc;
+    double r_fp_stack[8];
+    RecompXmm r_xmm[8];
+    RecompMmx r_mm[8];
+} RecompRegFile;
+
+#ifdef __cplusplus
+extern "C"
+#endif
+RecompRegFile *recomp_regfile(void) __attribute__((const, nothrow));
+
+#define g_eax             (recomp_regfile()->r_eax)
+#define g_ecx             (recomp_regfile()->r_ecx)
+#define g_edx             (recomp_regfile()->r_edx)
+#define g_esp             (recomp_regfile()->r_esp)
+#define g_ebx             (recomp_regfile()->r_ebx)
+#define g_esi             (recomp_regfile()->r_esi)
+#define g_edi             (recomp_regfile()->r_edi)
+#define g_ebp             (recomp_regfile()->r_ebp)
+#define g_fs_base         (recomp_regfile()->r_fs_base)
+#define g_seh_ebp         (recomp_regfile()->r_seh_ebp)
+#define g_eflags          (recomp_regfile()->r_eflags)
+#define g_df              (recomp_regfile()->r_df)
+#define g_fp_top          (recomp_regfile()->r_fp_top)
+#define g_fp_cmp          (recomp_regfile()->r_fp_cmp)
+#define g_fp_control_word (recomp_regfile()->r_fp_control_word)
+#define g_fp_cc           (recomp_regfile()->r_fp_cc)
+#define g_fp_stack        (recomp_regfile()->r_fp_stack)
+#define g_xmm0            (recomp_regfile()->r_xmm[0])
+#define g_xmm1            (recomp_regfile()->r_xmm[1])
+#define g_xmm2            (recomp_regfile()->r_xmm[2])
+#define g_xmm3            (recomp_regfile()->r_xmm[3])
+#define g_xmm4            (recomp_regfile()->r_xmm[4])
+#define g_xmm5            (recomp_regfile()->r_xmm[5])
+#define g_xmm6            (recomp_regfile()->r_xmm[6])
+#define g_xmm7            (recomp_regfile()->r_xmm[7])
+#define g_mm0             (recomp_regfile()->r_mm[0])
+#define g_mm1             (recomp_regfile()->r_mm[1])
+#define g_mm2             (recomp_regfile()->r_mm[2])
+#define g_mm3             (recomp_regfile()->r_mm[3])
+#define g_mm4             (recomp_regfile()->r_mm[4])
+#define g_mm5             (recomp_regfile()->r_mm[5])
+#define g_mm6             (recomp_regfile()->r_mm[6])
+#define g_mm7             (recomp_regfile()->r_mm[7])
+#endif /* __PROSPERO__ */
+
+#endif /* RECOMP_REGFILE_H */
