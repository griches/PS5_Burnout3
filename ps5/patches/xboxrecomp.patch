+int view_lookup(const void *addr, void **base_out, size_t *len_out);
+
+void xbox_compat_guest_window(void *lo, size_t size)
+{
+    s_ps5_window_lo = (uintptr_t)lo;
+    s_ps5_window_hi = (uintptr_t)lo + size;
